{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/fleet", "destination": "/api/fleet" },
    { "source": "/api/routes", "destination": "/api/routes" },
    { "source": "/api/rail-geometry", "destination": "/data/rail-network.json" },
    { "source": "/api/history", "destination": "/api/history" },
    { "source": "/api/record-gps", "destination": "/api/record?src=gps" },
    { "source": "/api/record-stats", "destination": "/api/record?src=stats" },
    { "source": "/api/record-extra", "destination": "/api/record?src=extra" },
    { "source": "/api/record-schedule", "destination": "/api/record?src=schedule" },
    { "source": "/api/record-context", "destination": "/api/record?src=context" },
    { "source": "/api/record-cercanias", "destination": "/api/record?src=cercanias" },
    { "source": "/api/record-regional", "destination": "/api/record?src=regional" },
    { "source": "/api/record-env", "destination": "/api/record?src=env" },
    { "source": "/api/analytics", "destination": "/api/analytics" }
  ],
  "headers": [
    {
      "source": "/api/rail-geometry",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
